# Copy to .env and fill in. .env is in .gitignore — never commit it.
#   cp .env.example .env

# --- PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- JWT (shared by agora-api and gateway-api), base64, >= 32 bytes ---
# Generate: openssl rand -base64 64
JWT_SECRET=

# --- Minio (root credentials, also used by agora-api) ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Grafana admin password (login: admin) ---
GRAFANA_ADMIN_PASSWORD=

# --- Config Server: branch of agora-config to serve (default: dev) ---
# CONFIG_GIT_LABEL=dev
